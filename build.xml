<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
  Ant build for TACO + Stryker (comitaco).

  Requirements: JDK 7 (see docs/BUILDING.md). Use the bundled Ant 1.9.x, since
  Ant 1.10+ cannot run on Java 7:

      JAVA_HOME=<path-to-jdk7> ant/bin/ant build

  or simply: scripts/build.sh
-->
<project basedir="." default="build" name="taco">

	<!-- PROPERTIES DEFINITION -->
	<property environment="env" />
	<property name="junit.output.dir" value="junit" />
	<property name="debuglevel" value="source,lines,vars" />

	<property name="target" value="1.7" />
	<property name="source" value="1.7" />

	<!-- File consumed by scripts/run-benchmark.sh to build the runtime classpath -->
	<property name="runtime.classpath.file" value="bin/runtime.classpath" />

	<!-- TACO properties definition -->
	<property name="app.id" value="taco" />
	<property name="app.version" value="1.2.0" />
	<property name="app.createdBy" value="The RFM Group at the Universidad de Buenos Aires, Argentina." />

	<!--
	  Library classpath. Keep the order and contents in sync with .classpath
	  (the Eclipse configuration the 2018 working version was run from).
	  lib/stryker/jml4c.jar is deliberately NOT on the classpath: Stryker runs it
	  as a separate process and loads it in its own class loader.
	-->
	<path id="lib.classpath">
		<pathelement location="lib/commons-configuration-1.6.jar" />
		<pathelement location="lib/commons-collections-3.2.1.jar" />
		<pathelement location="lib/commons-logging-1.1.1.jar" />
		<pathelement location="lib/edu.mit.csail.sdg.annotations_0.2.5.jar" />
		<pathelement location="lib/jml-release.jar" />
		<pathelement location="lib/junit-4.8.2.jar" />
		<pathelement location="lib/log4j-1.2.15.jar" />
		<pathelement location="lib/org.eclipse.text_3.5.200.v20120523-1310.jar" />
		<pathelement location="lib/org.eclipse.equinox.common_3.6.100.v20120522-1841.jar" />
		<pathelement location="lib/org.eclipse.equinox.preferences_3.5.0.v20120522-1841.jar" />
		<pathelement location="lib/org.eclipse.osgi_3.8.0.v20120529-1548.jar" />
		<pathelement location="lib/org.eclipse.core.contenttype_3.4.200.v20120523-2004.jar" />
		<pathelement location="lib/org.eclipse.core.jobs_3.5.200.v20120521-2346.jar" />
		<pathelement location="lib/org.eclipse.core.resources_3.8.0.v20120522-2034.jar" />
		<pathelement location="lib/org.eclipse.core.runtime_3.8.0.v20120521-2346.jar" />
		<pathelement location="lib/org.eclipse.jdt.core_3.8.1.v20120531-0637.jar" />
		<pathelement location="lib/commons-lang3-3.3.2.jar" />
		<pathelement location="lib/commons-lang-2.4.jar" />
		<pathelement location="lib/guava-16.0.1.jar" />
		<pathelement location="lib/javassist.jar" />
		<pathelement location="lib/reflections-0.9.9-RC1.jar" />
		<pathelement location="lib/antlr-4.3-complete.jar" />
		<pathelement location="lib/recoder.jar" />
		<pathelement location="lib/alloy4.jar" />
		<pathelement location="lib/dynalloy42018.jar" />
		<pathelement location="lib/jdynalloy2018.jar" />
		<pathelement location="lib/mujava2018.jar" />
		<pathelement location="lib/openjava2018.jar" />
	</path>

	<path id="build.classpath">
		<pathelement location="bin" />
		<path refid="lib.classpath" />
	</path>

	<!-- The project is compiled with the Eclipse compiler (ECJ), like in Eclipse. -->
	<path id="ecj.classpath">
		<pathelement location="lib/jdtCompilerAdapter.jar" />
		<pathelement location="lib/org.eclipse.jdt.core_3.8.1.v20120531-0637.jar" />
	</path>

	<!-- TASK DEFINITION -->
	<!-- init -->
	<!-- Class files and *_temp* backups that Stryker leaves next to the subjects in tests/
	     must not be copied: a stale class would shadow the real source in bin/. -->
	<target name="init" description="Copy non-Java resources (e.g. .djals/.als modules) to bin/">
		<fail message="Stryker requires JDK 7 (found Java ${java.specification.version} at ${java.home}). See docs/BUILDING.md.">
			<condition>
				<not><equals arg1="${java.specification.version}" arg2="1.7" /></not>
			</condition>
		</fail>
		<mkdir dir="bin" />
		<copy includeemptydirs="false" todir="bin">
			<fileset dir="src" excludes="**/*.launch, **/*.g, **/*.java, **/*.class, **/*_temp*" />
		</copy>
		<copy includeemptydirs="false" todir="bin">
			<fileset dir="tests" excludes="**/*.launch, **/*.g, **/*.java, **/*.class, **/*_temp*" />
		</copy>
		<copy includeemptydirs="false" todir="bin">
			<fileset dir="unittest" excludes="**/*.launch, **/*.g, **/*.java, **/*.class, **/*_temp*" />
		</copy>
	</target>

	<!-- Create jar file -->
	<target name="jar" depends="build" description="Build dist/taco.jar (TacoMain as Main-Class)">
		<mkdir dir="${basedir}/dist"/>
		<delete file="${basedir}/dist/${app.id}.jar"/>
		<delete dir="${basedir}/META-INF" />
		<buildnumber file="build.num"/>
		<tstamp>
		     <format property="TODAY" pattern="yyyy-MM-dd HH:mm:ss" />
		</tstamp>
		<jar jarfile="${basedir}/dist/${app.id}.jar" basedir="bin" includes="**/*.class **/*.djals **/*.als **/log4j.xml">
			<zipgroupfileset dir="${basedir}/lib" includes="*.jar" excludes="jdtCompilerAdapter.jar" />
			<manifest>
				<attribute name="Created-By" value="${app.createdBy}"/>
				<attribute name="Built-Date" value="${TODAY}"/>
				<attribute name="Main-Class" value="ar.edu.taco.TacoMain"/>
				<attribute name="Class-Path" value=" "/>
				<attribute name="Implementation-Version" value="${app.version}-b${build.number}"/>
			</manifest>
		</jar>
		<echo> Packing src files </echo>
		<zip destfile="${basedir}/dist/${app.id}_src.jar">
			<fileset dir="${basedir}" includes="src/**/*.java src/**/*.djals src/**/*.als src/**/.xml src/**/.g"/>
			<fileset dir="${basedir}" includes="tests/**/*.java"/>
			<fileset dir="${basedir}" includes="unittest/**/*.java"/>
			<fileset dir="${basedir}" includes="config/**/*.properties"/>
			<fileset dir="${basedir}" includes="specs/**/*"/>
		</zip>
		<!-- These tasks remove secury definition files from external libs to avoid a security exception -->
		<zip destfile="temp-jar-file.jar">
			<fileset dir="${basedir}/dist" includes="${app.id}_src.jar"/>
			<zipfileset src="${basedir}/dist/${app.id}.jar" excludes="META-INF/*.RSA, META-INF/*.DSA, META-INF/*.SF" />
		</zip>
		<move file="temp-jar-file.jar" tofile="${basedir}/dist/${app.id}.jar"/>
	</target>

	<!-- Build the project -->
	<target name="build" depends="compile" description="Compile src/, tests/ and unittest/ into bin/ (default)" />

	<!-- Compile the project -->
	<target name="compile" depends="init">
		<echo message="${ant.project.name}: ${ant.file}" />
		<javac compiler="org.eclipse.jdt.core.JDTCompilerAdapter" includeantruntime="false" encoding="UTF-8" nowarn="true"
			debug="true" debuglevel="${debuglevel}" destdir="bin" source="${source}" target="${target}">
			<compilerclasspath refid="ecj.classpath" />
			<src path="src" />
			<classpath refid="build.classpath" />
		</javac>
		<javac compiler="org.eclipse.jdt.core.JDTCompilerAdapter" includeantruntime="false" encoding="UTF-8" nowarn="true"
			debug="true" debuglevel="${debuglevel}" destdir="bin" source="${source}" target="${target}">
			<compilerclasspath refid="ecj.classpath" />
			<src path="tests" />
			<classpath refid="build.classpath" />
		</javac>
		<javac compiler="org.eclipse.jdt.core.JDTCompilerAdapter" includeantruntime="false" encoding="UTF-8" nowarn="true"
			debug="true" debuglevel="${debuglevel}" destdir="bin" source="${source}" target="${target}">
			<compilerclasspath refid="ecj.classpath" />
			<src path="unittest" />
			<classpath refid="build.classpath" />
		</javac>
		<!-- Relative to the repository root, so that a build made in the Docker image
		     (scripts/docker.sh) also works on the host, and vice versa. -->
		<pathconvert property="runtime.classpath" refid="build.classpath">
			<map from="${basedir}${file.separator}" to="" />
		</pathconvert>
		<echo file="${runtime.classpath.file}" message="${runtime.classpath}" />
	</target>

	<!-- TESTS -->
	<!--
	  Runs EVERY *Test.java under unittest/, including hundreds of Stryker
	  repair benchmarks: this takes many hours. To run a single benchmark use
	  scripts/run-benchmark.sh instead.
	-->
	<target name="unittest" depends="build" description="Run ALL unittest/ classes (very slow)">
		<mkdir dir="${junit.output.dir}" />
		<junit fork="yes" printsummary="on" dir="${basedir}">
			<jvmarg value="-Xmx1024m" />
			<jvmarg value="-Xms512m" />
			<jvmarg value="-Xss2048k" />
			<formatter type="xml" />
			<batchtest todir="${junit.output.dir}">
				<fileset dir="unittest" includes="**/*Test.java">
					<exclude name="ar.edu.dynjml4alloy.regresion.BaseRegresionTest" />
					<exclude name="ar.edu.dynjml4alloy.parser.common.JDynAlloyParserTest" />
				</fileset>
			</batchtest>
			<classpath refid="build.classpath" />
		</junit>
	</target>

	<!-- JUnit test reports -->
	<target name="junitreport">
		<junitreport todir="${junit.output.dir}">
			<fileset dir="${junit.output.dir}">
				<include name="TEST-*.xml" />
			</fileset>
			<report format="frames" todir="${junit.output.dir}" />
		</junitreport>
	</target>

	<!-- clear project and parser -->
	<target name="clean" description="Delete bin/">
		<delete dir="bin" />
	</target>


</project>
